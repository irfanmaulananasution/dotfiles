# Template for the kustomize secretGenerator env file (k8s/.env).
# In practice k8s/setup.sh auto-generates .local/k8s.env.local from
# .local/.env.local and copies it here only transiently during apply.
# Never commit real values.

LITELLM_KEY=sk-litellm-local-dev
PERSONAL_OPENCODE_API_KEY=sk-your-key-here
PERSONAL_DEEPSEEK_API_KEY=sk-your-deepseek-key-here
PHOENIX_DB_PASSWORD=phoenix
