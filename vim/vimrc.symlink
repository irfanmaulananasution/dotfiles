syntax on
set number
set relativenumber
set tabstop=2
set shiftwidth=2
set expandtab
set smartindent
set hlsearch
set incsearch
set ignorecase
set smartcase
set hidden
set noswapfile
set nobackup
set nowritebackup
set scrolloff=8
set sidescrolloff=8
set wildmenu
set wildmode=list:longest
set mouse=a