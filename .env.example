PERSONAL_DEEPSEEK_API_KEY="sk-"
PERSONAL_OPENCODE_API_KEY="sk-"
PERSONAL_API_KEY=$PERSONAL_OPENCODE_API_KEY

# LiteLLM proxy admin key (auto-generated by topics-ai/litellm/install.sh if empty)
LITELLM_KEY=

# Postgres password. Defaults to "phoenix" for the local Docker stack
# (Postgres is loopback-only). Required (non-empty) for k8s/setup.sh.
PHOENIX_DB_PASSWORD=

# Git identity (used by git/install.sh)
GIT_AUTHOR_NAME="irfanmaulananasution"
GIT_AUTHOR_EMAIL="46064787+irfanmaulananasution@users.noreply.github.com"

# OpenCode web server password (used by topics-ai/opencode/install.sh)
# Set a password to secure the web interface when accessed over the network
# OPENCODE_SERVER_PASSWORD="your-secret-password"

# Hermes Agent (topics-ai/hermes/install.sh)
# Optional: BackSearch plugin (hermes-plugin-backsearch) gates its tools on an
# OpenReward prepaid key. Once set, topics-ai/hermes/install.sh mirrors it into ~/.hermes/.env.
# Get a key at https://openreward.ai/
# OPENREWARD_API_KEY="or-"
